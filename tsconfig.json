{
  "compilerOptions": {
    "target": "es2018",
    "module": "node16",
    "lib": [
      "es2018"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test/*": [
        "./test/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "express.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
