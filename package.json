{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the Auth Example project",
  "main": "index.js",
  "keywords": [],
  "author": "Ramon Nunes",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register --env-file .env ./src/main/server.ts",
    "build": "npm run prisma:generate && tsc && tsc-alias -p tsconfig.json && cp -r src/main/db dist/main/",
    "start": "node -r tsconfig-paths/register --env-file .env ./dist/main/server.js",
    "prisma:generate": "prisma generate --schema=./prisma/",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/",
    "prisma:studio": "prisma studio --schema=./prisma/",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1156.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prisma": "^7.10.1",
    "tsc-alias": "^1.9.9",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
